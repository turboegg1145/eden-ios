<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Standard sandboxed application. Do NOT add platform-application or
	  com.apple.private.security.no-container / container-required: iOS then
	  treats the process as a container-less daemon, revokes access to the GPU
	  driver (AGXDeviceUserClient / IOSurface) and breaks the Documents
	  container. MTLCreateSystemDefaultDevice() and EAGLContext both return
	  nil in that state, which is exactly the black-screen failure this
	  file must avoid.
	-->
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
